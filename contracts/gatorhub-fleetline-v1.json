          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "value": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\+?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?$",
              "x-decimal-max-digits": 16,
              "x-decimal-places": 3
