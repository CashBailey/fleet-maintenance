        },
        {
          "required": [
            "kind",
            "unit"
          ]
        }
      ],
      "x-units-by-kind": {
        "odometer": [
          "mi",
          "km"
        ],
        "engine_hours": [
          "h"
        ],
        "other": "nonempty"
      },
      "properties": {
        "meter_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "odometer",
            "engine_hours",
            "other"
          ]
        },
