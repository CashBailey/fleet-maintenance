                  {
                    "type": "string",
                    "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  }
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "calculated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
