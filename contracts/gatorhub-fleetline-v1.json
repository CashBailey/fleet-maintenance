{
  "contract_id": "gatorhub-fleetline",
  "version": "1.3.0",
  "authority": "fleetline",
  "source_system": "gatorhub",
  "tenant_binding": {
    "mode": "explicit",
    "cardinality": "one_gatorhub_deployment_to_one_fleetline_organization"
  },
  "transport": {
    "api_base_path": "/api/v1",
    "authentication": "scoped_bearer_token",
    "required_scopes": [
      "assets.view",
      "assets.sync",
      "personnel.sync"
    ],
    "required_scopes_semantics": "union_of_enabled_gatorhub_sync_operations_not_required_on_every_token",
    "idempotency_header": "Idempotency-Key",
    "service_token_topology": {
      "issuer": "fleetline",
      "holder": "gatorhub_server_only",
      "credential_type": "opaque_expiring_scoped_token",
      "stored_by_fleetline_as": "sha256_hash",
      "minimum_combined_sync_scopes": [
        "assets.view",
        "assets.sync",
        "personnel.sync"
      ],
      "never_expose_to": [
        "browser_javascript",
        "url",
        "local_storage",
        "client_log"
      ],
      "forbidden_substitutes": [
        "gatorhub_human_jwt",
        "gatorhub_jwt_signing_secret",
        "shared_database_credentials"
      ],
      "not_granted_for_sync": [
        "pm.manage",
        "maintenance.manage",
        "admin.users"
      ]
    },
    "asset_upsert": {
      "method": "PUT",
      "path": "/api/v1/assets/external/{source_system}/{external_id}/",
      "requires_api_token": true,
      "required_scope": "assets.sync",
      "path_schema": "#/schemas/ExternalAssetIdentityParameters",
      "request_schema": "#/schemas/ExternalAssetPutRequest",
      "responses": {
        "200": "#/schemas/ExternalAssetPutResponse",
        "201": "#/schemas/ExternalAssetPutResponse",
        "400": "#/schemas/ErrorEnvelope",
        "403": "#/schemas/ErrorEnvelope",
        "404": "#/schemas/ErrorEnvelope",
        "409": "#/schemas/ErrorEnvelope"
      }
    },
    "asset_lookup": {
      "method": "GET",
      "path": "/api/v1/assets/external/{source_system}/{external_id}/"
    },
    "meter_ingest": {
      "method": "POST",
      "path": "/api/v1/assets/external/{source_system}/{external_id}/meters/",
      "requires_api_token": true,
      "required_scope": "assets.sync",
      "path_schema": "#/schemas/ExternalAssetIdentityParameters",
      "request_schema": "#/schemas/ExternalMeterPostRequest",
      "responses": {
        "201": "#/schemas/ExternalMeterPostResponse",
        "400": "#/schemas/ErrorEnvelope",
        "403": "#/schemas/ErrorEnvelope",
        "404": "#/schemas/ErrorEnvelope",
        "409": "#/schemas/ErrorEnvelope"
      }
    },
    "personnel_projection_upsert": {
      "method": "PUT",
      "path": "/api/v1/maintenance/personnel/external/{source_system}/{external_employee_id}/",
      "requires_api_token": true,
      "required_scope": "personnel.sync",
      "idempotency_header_required": true,
      "path_schema": "#/schemas/ExternalEmployeeIdentityParameters",
      "request_schema": "#/schemas/ExternalEmployeePutRequest",
      "responses": {
        "200": "#/schemas/ExternalEmployeePutResponse",
        "201": "#/schemas/ExternalEmployeePutResponse",
        "400": "#/schemas/ErrorEnvelope",
        "403": "#/schemas/ErrorEnvelope",
        "409": "#/schemas/ErrorEnvelope"
      }
    },
    "work_order_assignment_replace": {
      "method": "POST",
      "path": "/api/v1/maintenance/work-orders/{work_order_id}/assignments/",
      "authentication": "fleetline_human_session",
      "requires_api_token": false,
      "required_permission": "maintenance.manage",
      "idempotency_header_required": true,
      "request_schema": "#/schemas/WorkOrderAssignmentReplaceRequest",
      "response": "fleetline_work_order_representation"
    },
    "webhook": {
      "schema_version": "1.0",
      "signature_header": "X-Fleetline-Signature",
      "signature_algorithm": "hmac-sha256",
      "deduplication_field": "id",
      "envelope_schema": "#/schemas/WebhookEnvelope",
      "projection_event_schema": "#/schemas/MaintenancePlanProjectionChangedWebhook"
    }
  },
  "identifiers": {
    "vehicle": {
      "source_field": "Vehicle.id",
      "source_format": "uuid",
      "target_source_system": "gatorhub",
      "target_external_id_field": "Asset.external_id",
      "display_source_field": "Vehicle.truck_no",
      "display_target_field": "Asset.unit_number",
      "display_normalization": "trim_and_uppercase",
      "never_identity_fields": [
        "Vehicle.truck_no",
        "Vehicle.vin"
      ]
    },
    "employee": {
      "source_field": "Employee.id",
      "source_format": "uuid",
      "target_source_system": "gatorhub",
      "target_external_id_field": "ExternalEmployeeProjection.external_employee_id",
      "optional_login_reference_source_field": "User.id",
      "optional_login_reference_target_field": "ExternalEmployeeProjection.external_user_id",
      "never_identity_fields": [
        "User.id",
        "User.username",
        "Employee.name",
        "Employee.email"
      ]
    },
    "meter_external_id_template": "gatorhub:vehicle_inspection:{inspection_id}:{field}",
    "meter_external_id_fields": [
      "odometer_begin",
      "odometer_end"
    ]
  },
  "field_ownership": {
    "gatorhub": [
      "Vehicle.id",
      "Vehicle.truck_no",
      "Vehicle.vin",
      "Vehicle.year",
      "Vehicle.make",
      "Vehicle.model",
      "Vehicle.vehicle_type",
      "Vehicle.license_plate",
      "Vehicle.capacity_bbl",
      "Employee.id",
      "Employee.name",
      "Employee.preferred_name",
      "Employee.job_title",
      "Employee.department",
      "Employee.status",
      "User.id"
    ],
    "fleetline": [
      "Asset.id",
      "Asset.status",
      "Asset.home_location",
      "Asset.assigned_driver",
      "Meter",
      "MeterReading",
      "ServicePackage",
      "MaintenancePlan",
      "MaintenanceRequest",
      "WorkOrder",
      "ExternalEmployeeProjection.id",
      "WorkOrderAssignment",
      "Inventory"
    ],
    "gatorhub_projection_only": [
      "Vehicle.status",
      "Vehicle.active",
      "maintenance_due_summary"
    ]
  },
  "field_mappings": {
    "truck_no": "unit_number",
    "vin": "vin",
    "year": "year",
    "make": "make",
    "model": "model",
    "vehicle_type": {
      "target": "asset_type",
      "source_detail": "specs.integrations.gatorhub.vehicle_type"
    },
    "license_plate": "specs.integrations.gatorhub.license_plate",
    "capacity_bbl": "specs.integrations.gatorhub.capacity_bbl"
  },
  "personnel_field_mappings": {
    "Employee.id": "ExternalEmployeeProjection.external_employee_id",
    "Employee.display_name": "ExternalEmployeeProjection.display_name",
    "Employee.job_title": "ExternalEmployeeProjection.job_title",
    "Employee.department": "ExternalEmployeeProjection.department",
    "approved_operational_status": "ExternalEmployeeProjection.active",
    "User.id": "ExternalEmployeeProjection.external_user_id"
  },
  "personnel_status_policy": {
    "active_true_when": "employee_is_active_and_in_approved_maintenance_assignment_population",
    "active_false_when": "employee_is_inactive_or_removed_from_approved_maintenance_assignment_population",
    "partial_run_omission": "no_change",
    "full_snapshot_omission": "no_change_until_explicit_inactivation_is_sent",
    "inactive_projection_effect": "excluded_from_new_assignments_but_retained_in_history",
    "existing_active_assignment_effect": "retained_for_auditable_history_and_requires_manager_review",
    "local_login_effect": "none"
  },
  "personnel_authorization_policy": {
    "projection_creates_fleetline_login": false,
    "projection_grants_fleetline_role": false,
    "gatorhub_role_hints_are_authorization": false,
    "assignment_picker_population": "active_explicitly_approved_external_projections",
    "work_execution_requires": "active_local_fleetline_user_with_server_side_permission_and_active_team_membership",
    "work_order_team_changes_require": "fleetline_maintenance_manager_human_session"
  },
  "work_order_assignment_history": {
    "storage": "append_only_assignment_and_unassignment_events",
    "assignment_time_snapshot_fields": [
      "subject_display_name",
      "subject_source_system",
      "subject_external_employee_id",
      "subject_source_version"
    ],
    "serialized_snapshot_fields": [
      "display_name",
      "source_system",
      "external_employee_id",
      "source_version"
    ],
    "unassignment_uses_original_assignment_snapshot": true,
    "new_event_snapshot_timing": "assignment_event_creation",
    "legacy_backfill": "migration_0008_freezes_best_available_identity_at_migration_time",
    "profile_fields_not_snapshotted": [
      "external_user_id",
      "job_title",
      "department"
    ],
    "current_team_projection": "latest_event_per_subject",
    "legacy_assigned_to_policy": "temporary_local_lead_compatibility_projection"
  },
  "status_mappings": {
    "initial_import": {
      "active": "Available",
      "available": "Available",
      "out_of_service": "OutOfService"
    },
    "initial_import_application": "review_then_fleetline_status_transition",
    "inactive_source_policy": "manual_review_before_retired",
    "fleetline_to_gatorhub": {
      "Available": {
        "status": "available",
        "active_policy": "preserve"
      },
      "Restricted": {
        "status": "out_of_service",
        "active_policy": "preserve"
      },
      "OutOfService": {
        "status": "out_of_service",
        "active_policy": "preserve"
      },
      "Retired": {
        "status": "out_of_service",
        "active_policy": "set_false"
      }
    },
    "pm_due_dispatch_policy": "informational_unless_approved_rule"
  },
  "role_hints": {
    "driver": "driver",
    "lead_driver": "driver",
    "mechanic": "technician",
    "lead_mechanic": "supervisor",
    "owner": "management",
    "admin": "system_admin"
  },
  "roles_requiring_manual_approval": [
    "supervisor",
    "system_admin"
  ],
  "roles_never_inferred_from_gatorhub": [
    "fleet_manager",
    "parts_clerk",
    "purchasing_manager",
    "integration_admin"
  ],
  "personnel_sync_readiness": {
    "status": "fleetline_boundary_implemented_gatorhub_adapter_not_implemented",
    "live_gatorhub_sync": false,
    "upstream_blockers": [
      {
        "id": "gatorhub_outbound_adapter",
        "required": "server_side_fleetline_client_configuration_reconciliation_status_and_retry"
      },
      {
        "id": "approved_eligibility_mapping",
        "required": "organization_approved_rule_or_allowlist_for_maintenance_assignment_population"
      },
      {
        "id": "complete_change_watermark",
        "required": "monotonic_cursor_covering_employee_and_optional_linked_user_changes"
      },
      {
        "id": "explicit_inactivation_delivery",
        "required": "retryable_delivery_of_active_false_without_inferring_from_partial_results"
      },
      {
        "id": "production_secret_provisioning",
        "required": "fleetline_issued_scoped_token_stored_only_in_gatorhub_server_secret_configuration"
      }
    ]
  },
  "events": {
    "fleetline_to_gatorhub": [
      "asset.availability_changed",
      "maintenance.due",
      "maintenance.plan_projection_changed",
      "work_order.completed"
    ],
    "gatorhub_to_fleetline": [
      {
        "logical_type": "vehicle.upsert",
        "transport": "asset_upsert"
      },
      {
        "logical_type": "vehicle_inspection.odometer",
        "transport": "meter_ingest"
      },
      {
        "logical_type": "employee.projection_upsert",
        "transport": "personnel_projection_upsert",
        "availability": "fleetline_receiver_only_until_gatorhub_adapter_is_implemented"
      }
    ],
    "payloads": {
      "maintenance.plan_projection_changed": {
        "schema_version": "1.0",
        "emitted_when": [
          "maintenance_plan_created",
          "due_status_changed",
          "after_successful_pm_trigger_reset_on_work_order_close"
        ],
        "resource_type": "MaintenancePlan",
        "schema": "#/schemas/MaintenancePlanProjectionChangedData",
        "nullable_fields": [
          "source_system",
          "external_id",
          "work_order_id"
        ],
        "required_fields": [
          "schema_version",
          "asset_id",
          "source_system",
          "external_id",
          "work_order_id",
          "maintenance_plan_id",
          "due_status",
          "next_due",
          "calculated_at"
        ],
        "next_due_fields": [
          "trigger_id",
          "kind",
          "status",
          "due_at",
          "due_value",
          "grace_until",
          "unit",
          "message"
        ]
      }
    }
  },
  "json_schema_dialect": "https://json-schema.org/draft/2020-12/schema",
  "schemas": {
    "ExternalAssetIdentityParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "external_id"
      ],
      "properties": {
        "source_system": {
          "type": "string",
          "const": "gatorhub",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9._-]{0,39}$"
        },
        "external_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
        }
      },
      "examples": [
        {
          "source_system": "gatorhub",
          "external_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb"
        }
      ]
    },
    "ExternalEmployeeIdentityParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "external_employee_id"
      ],
      "properties": {
        "source_system": {
          "type": "string",
          "const": "gatorhub",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9._-]{0,39}$"
        },
        "external_employee_id": {
          "type": "string",
          "format": "uuid",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "examples": [
        {
          "source_system": "gatorhub",
          "external_employee_id": "12121212-1212-4121-8121-121212121212"
        }
      ]
    },
    "ExternalEmployeePutRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "active",
        "source_version",
        "source_updated_at"
      ],
      "x-idempotency": "A UUID Idempotency-Key is required. Reuse with the identical method, route, and body replays the stored response; reuse with different input returns 409.",
      "x-source-ordering": "An older source_updated_at returns 409. Equal source_updated_at with different projected fields returns 409. Identical current content returns changed=false.",
      "x-forbidden-source-fields": [
        "email",
        "phone",
        "password",
        "roles",
        "permissions",
        "jwt"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "active": {
          "type": "boolean"
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "external_user_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 160
        },
        "job_title": {
          "type": "string",
          "maxLength": 160
        },
        "department": {
          "type": "string",
          "maxLength": 160
        }
      },
      "examples": [
        {
          "display_name": "Avery Technician",
          "active": true,
          "source_version": "sha256:7a3b1e8e9e63",
          "source_updated_at": "2026-09-04T14:15:00Z",
          "external_user_id": "34343434-3434-4343-8343-343434343434",
          "job_title": "Mechanic",
          "department": "Maintenance"
        }
      ]
    },
    "ExternalEmployeeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_system",
        "external_employee_id",
        "display_name",
        "job_title",
        "department",
        "active",
        "source_version",
        "source_updated_at",
        "synced_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "source_system": {
          "type": "string",
          "const": "gatorhub",
          "maxLength": 40
        },
        "external_employee_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 160
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "job_title": {
          "type": "string",
          "maxLength": 160
        },
        "department": {
          "type": "string",
          "maxLength": 160
        },
        "active": {
          "type": "boolean"
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "synced_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ExternalEmployeePutResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "employee",
        "created",
        "changed"
      ],
      "properties": {
        "employee": {
          "$ref": "#/schemas/ExternalEmployeeProjection"
        },
        "created": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        }
      },
      "examples": [
        {
          "employee": {
            "id": "56565656-5656-4565-8565-565656565656",
            "source_system": "gatorhub",
            "external_employee_id": "12121212-1212-4121-8121-121212121212",
            "display_name": "Avery Technician",
            "job_title": "Mechanic",
            "department": "Maintenance",
            "active": true,
            "source_version": "sha256:7a3b1e8e9e63",
            "source_updated_at": "2026-09-04T14:15:00Z",
            "synced_at": "2026-09-04T14:15:03Z"
          },
          "created": true,
          "changed": true
        }
      ]
    },
    "WorkOrderAssignmentReplaceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_version",
        "assignees"
      ],
      "x-max-leads": 1,
      "x-replacement-semantics": "The submitted set becomes the active team. Deltas append assigned or unassigned facts; existing facts are never edited or deleted.",
      "properties": {
        "base_version": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "assignees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role"
            ],
            "oneOf": [
              {
                "required": [
                  "user_id"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "source_system"
                      ]
                    },
                    {
                      "required": [
                        "external_employee_id"
                      ]
                    }
                  ]
                }
              },
              {
                "required": [
                  "source_system",
                  "external_employee_id"
                ],
                "not": {
                  "required": [
                    "user_id"
                  ]
                }
              }
            ],
            "properties": {
              "user_id": {
                "type": "string",
                "format": "uuid"
              },
              "source_system": {
                "type": "string",
                "const": "gatorhub",
                "maxLength": 40
              },
              "external_employee_id": {
                "type": "string",
                "format": "uuid",
                "maxLength": 160
              },
              "role": {
                "enum": [
                  "lead",
                  "technician"
                ]
              }
            }
          }
        }
      },
      "examples": [
        {
          "base_version": 4,
          "reason": "Assign PM inspection team",
          "assignees": [
            {
              "user_id": "78787878-7878-4787-8787-787878787878",
              "role": "lead"
            },
            {
              "source_system": "gatorhub",
              "external_employee_id": "12121212-1212-4121-8121-121212121212",
              "role": "technician"
            }
          ]
        }
      ]
    },
    "ExternalAssetPutRequest": {
      "type": "object",
      "additionalProperties": false,
      "not": {
        "required": [
          "asset_type_id",
          "asset_type"
        ]
      },
      "dependentRequired": {
        "asset_type_category": [
          "asset_type"
        ]
      },
      "x-create-required": {
        "all": [
          "unit_number"
        ],
        "one_of": [
          "asset_type_id",
          "asset_type"
        ]
      },
      "properties": {
        "asset_type_id": {
          "type": "string",
          "format": "uuid"
        },
        "asset_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "asset_type_category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "unit_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "vin": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "serial_number": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 32767
        },
        "make": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "source_details": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
          },
          "additionalProperties": true,
          "x-max-serialized-bytes": 8192
        }
      },
      "examples": [
        {
          "asset_type": "Truck",
          "asset_type_category": "vehicle",
          "unit_number": "000",
          "vin": "1XKZD48X0RJ000001",
          "year": 2024,
          "make": "Kenworth",
          "model": "T880",
          "source_details": {
            "vehicle_type": "vacuum_truck",
            "license_plate": "TX-000",
            "capacity_bbl": 130
          }
        }
      ]
    },
    "MeterReading": {
