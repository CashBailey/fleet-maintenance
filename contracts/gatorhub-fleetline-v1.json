                "type": "string",
                "format": "date-time"
              },
              "due_value": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
              },
              "grace_until": {
                "oneOf": [
                  {
                    "type": "string",
                    "format": "date-time"
